tcp_ssl_port=443" > /root/.ports

        systemctl daemon-reload
        systemctl enable php-webinfo
        systemctl start php-webinfo
    } &>/dev/null
}

start_service () {
    clear
    echo 'Starting and finalizing...'
    {
        (crontab -l 2>/dev/null; echo "* * * * * pgrep -x stunnel4 >/dev/null || systemctl restart stunnel4
* * * * * /bin/bash /etc/.ws >/dev/null 2>&1
* * * * * /bin/bash /etc/.monitor ssh >/dev/null 2>&1") | crontab -
        
        systemctl restart cron
        
        # Run monitor once to populate panel
        bash /etc/.monitor ssh >/dev/null 2>&1
    } &>/dev/null
    
    clear
    echo '++++++++++++++++++++++++++++++++++'
    echo '* SSH AIO is ready!      *'
    echo '+++++++++++************+++++++++++'
    history -c;
    rm -f /usr/local/etc/.system
    echo 'Server will reboot in 10 seconds...'
    sleep 10
    reboot
}

