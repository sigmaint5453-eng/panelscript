install_monitor() {
    clear
    echo "Installing native SSH monitor script..."
    cat << 'EOF' > /etc/.monitor
#!/bin/bash

service=$1

ip=$(curl -s --max-time 10 https://api.ipify.org || hostname -I | awk '{print $1}')
ip=$(echo "$ip" | tr -d '[:space:]')

os=$(source /etc/os-release && echo "$NAME")
distro=$(source /etc/os-release && echo "$PRETTY_NAME")
cpu=$(grep -m 1 'model name' /proc/cpuinfo | cut -d: -f2 | xargs)
memory=$(free -m | awk '/^Mem:/ {print $3 "MiB / " $2 "MiB"}')
disk=$(df -h / | awk 'NR==2 {print $3 " / " $2}')
uptime=$(uptime -p | sed 's/^up //')

# Grab vnstat bandwidth. If it's blank (fresh install), force it to show 0.00 KB
bandwidth=$(vnstat --oneline 2>/dev/null | cut -d ";" -f 15)
[ -z "$bandwidth" ] && bandwidth="0.00 KB"

if [[ $service == "ssh" ]]; then
    
    # Check if native SSH or Dropbear is active
    ssh_status=$(systemctl is-active sshd)
    [ "$ssh_status" != "active" ] && ssh_status=$(systemctl is-active ssh)
    
    dropbear_status=$(systemctl is-active dropbear)
    ssl_status=$(systemctl is-active stunnel4)
    squid_status=$(systemctl is-active squid)
    
    # Check if Python WS Proxy is listening on port 80
    if timeout 1 bash -c '</dev/tcp/127.0.0.1/80' 2>/dev/null; then 
        socket_status="active"
    else 
        socket_status="inactive"
    fi

    # Count online SSH & Dropbear users (ESTABLISHED connections)
    ssh_online=$(netstat -natp | grep -E "ESTABLISHED.*(sshd|dropbear)" | wc -l)
    
    . /root/.ports
    . /etc/.db-base

    mysql --skip-ssl -u "$USER" -p"$PASS" -D "$DB" -h "$HOST" -e \
    "UPDATE server_list SET 
        cpu_model='$cpu', 
        distro='$distro', 
        memory='$memory', 
        uptime='$uptime', 
        disk='$disk', 
        bandwidth='$bandwidth', 
        os='$os', 
        proto='$service', 
        ssh_status='$ssh_status', 
        dropbear_status='$dropbear_status', 
        ssl_status='$ssl_status', 
        squid_status='$squid_status', 
        socket_status='$socket_status', 
        ssh_port='$ssh_port', 
        dropbear_port='$dropbear_port', 
        tcpssl='$tcp_ssl_port', 
        squid='$squid_port', 
        socket='$socket_port', 
        ssh_online='$ssh_online' 
    WHERE server_ip='$ip'"

else
    echo "Usage: $0 ssh"
    exit 1
fi
EOF

    chmod +x /etc/.monitor
}

install_systemd_services(){
