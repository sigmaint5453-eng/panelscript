install_openvpn()
{
clear
echo "Installing openvpn."
{
mkdir -p /etc/openvpn/easy-rsa/keys
mkdir -p /etc/openvpn/login
mkdir -p /etc/openvpn/server
mkdir -p /var/www/html/stat
touch /etc/openvpn/server.conf
touch /etc/openvpn/server2.conf

echo 'DNS=1.1.1.1
DNSStubListener=no' >> /etc/systemd/resolved.conf

cat <<EOF > /etc/openvpn/server.conf
port PORT_UDP
proto udp
dev tun
server 10.20.0.0 255.255.0.0
max-clients 5000
ca /etc/openvpn/easy-rsa/keys/ca.crt
cert /etc/openvpn/easy-rsa/keys/server.crt
key /etc/openvpn/easy-rsa/keys/server.key
dh none
tls-server
tls-version-min 1.2
auth SHA256
cipher AES-128-GCM
data-ciphers AES-128-GCM:AES-256-GCM:AES-128-CBC
data-ciphers-fallback AES-128-CBC
keepalive 10 120
persist-key
persist-tun
user nobody
group nogroup
client-to-client
duplicate-cn
verify-client-cert none
username-as-common-name
script-security 3
auth-user-pass-verify "/etc/openvpn/login/auth_vpn" via-env
push "redirect-gateway def1 bypass-dhcp"
push "dhcp-option DNS 8.8.8.8"
push "dhcp-option DNS 8.8.4.4"
log /etc/openvpn/server/udpserver.log
status /etc/openvpn/server/udpclient.log
verb 3
client-connect /etc/openvpn/login/connect.sh
client-disconnect /etc/openvpn/login/disconnect.sh
EOF

cat <<EOF > /etc/openvpn/server2.conf
port PORT_TCP
proto tcp
dev tun
server 10.30.0.0 255.255.255.0
max-clients 5000
ca /etc/openvpn/easy-rsa/keys/ca.crt
cert /etc/openvpn/easy-rsa/keys/server.crt
key /etc/openvpn/easy-rsa/keys/server.key
dh none
tls-server
tls-version-min 1.2
cipher AES-128-CBC
auth SHA256
data-ciphers AES-128-CBC:AES-256-GCM:AES-128-GCM
data-ciphers-fallback AES-128-CBC
keepalive 10 120
persist-key
persist-tun
user nobody
group nogroup
client-to-client
duplicate-cn
username-as-common-name
script-security 3
auth-user-pass-verify "/etc/openvpn/login/auth_vpn" via-env
verify-client-cert none
push "redirect-gateway def1 bypass-dhcp"
push "dhcp-option DNS 8.8.8.8"
push "dhcp-option DNS 8.8.4.4"
log /etc/openvpn/server/tcpserver.log
status /etc/openvpn/server/tcpclient.log
verb 3
client-connect /etc/openvpn/login/connect.sh
client-disconnect /etc/openvpn/login/disconnect.sh
EOF

sed -i "s|PORT_UDP|$PORT_UDP|g" /etc/openvpn/server.conf
sed -i "s|PORT_TCP|$PORT_TCP|g" /etc/openvpn/server2.conf

cat <<\EOM >/etc/openvpn/login/config.sh
#!/bin/bash
HOST='DBHOST'
USER='DBUSER'
PASS='DBPASS'
DB='DBNAME'
EOM

sed -i "s|DBHOST|$HOST|g" /etc/openvpn/login/config.sh
sed -i "s|DBUSER|$USER|g" /etc/openvpn/login/config.sh
sed -i "s|DBPASS|$PASS|g" /etc/openvpn/login/config.sh
sed -i "s|DBNAME|$DBNAME|g" /etc/openvpn/login/config.sh

#TCP authentication
wget -O /etc/openvpn/login/auth_vpn "$BASE_URL/authentication/bluepanel/auth_vpn"

#client-connect file
wget -O /etc/openvpn/login/connect.sh "$BASE_URL/authentication/connect.sh"

sed -i "s|SERVER_IP|$server_ip|g" /etc/openvpn/login/connect.sh

#TCP client-disconnect file
wget -O /etc/openvpn/login/disconnect.sh "$BASE_URL/authentication/disconnect.sh"

sed -i "s|SERVER_IP|$server_ip|g" /etc/openvpn/login/disconnect.sh


#Configured ca.rt
wget -O /etc/openvpn/easy-rsa/keys/ca.crt "$BASE_URL/newcert/ca.crt"

#Configured server.crt
wget -O /etc/openvpn/easy-rsa/keys/server.crt "$BASE_URL/newcert/server.crt"

#Configured server.key
wget -O /etc/openvpn/easy-rsa/keys/server.key "$BASE_URL/newcert/server.key"

#Configured dh.pem
wget -O /etc/openvpn/easy-rsa/keys/dh.pem "$BASE_URL/newcert/dh.pem"


dos2unix /etc/openvpn/login/auth_vpn
dos2unix /etc/openvpn/login/connect.sh
dos2unix /etc/openvpn/login/disconnect.sh

chmod 777 -R /etc/openvpn/
chmod 755 /etc/openvpn/server.conf
chmod 755 /etc/openvpn/server2.conf
chmod 755 /etc/openvpn/login/connect.sh
