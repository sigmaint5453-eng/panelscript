    log "Installing Hysteria..."

    wget \
        --no-check-certificate \
        -q \
        -O /root/install_server.sh \
        https://mediatekvpn.uk/sabrinavpn/install_server.sh ||
        fail_install "Hysteria installer download failed."

    chmod +x /root/install_server.sh

    /root/install_server.sh --version v1.3.5 ||
        fail_install "Hysteria installation failed."

    mkdir -p /etc/hysteria

    cat >/etc/hysteria/config.json <<EOF
{
  "listen": ":5666",
  "cert": "/etc/openvpn/easy-rsa/keys/server.crt",
  "key": "/etc/openvpn/easy-rsa/keys/server.key",
  "up_mbps": 100,
  "down_mbps": 100,
  "disable_udp": false,
  "obfs": "$OBFS",
  "prometheus_listen": ":5665",
  "recv_window_conn": 107374182400,
  "recv_window_client": 13421772800
}
EOF

    chmod 600 /etc/hysteria/config.json

    sysctl -w net.core.rmem_max=16777216 || true
    sysctl -w net.core.wmem_max=16777216 || true

    wget -q \
        -O /usr/bin/badvpn-udpgw \
        https://mediatekvpn.uk/sabrinavpn/badvpn-udpgw64 ||
        fail_install "badvpn-udpgw download failed."

    chmod +x /usr/bin/badvpn-udpgw
}

# ============================================================
# SQUID + SOCKS
# ============================================================

install_squid() {

    log "Installing Squid and SOCKS..."

    wget \
        --no-check-certificate \
        -q \
        -O /etc/init.d/squid \
        https://mediatekvpn.uk/sabrinavpn/squid.sh ||
        fail_install "Squid init script download failed."

    chmod +x /etc/init.d/squid

    update-rc.d squid defaults 2>/dev/null || true

    mkdir -p /etc/squid
    mkdir -p /var/log/squid

    rm -f /etc/squid/squid.conf

    cat >/etc/squid/squid.conf <<EOF
acl Firenet dst $server_ip

http_port 8080
http_port 8181

visible_hostname Proxy

acl PURGE method PURGE
acl HEAD method HEAD
acl POST method POST
acl GET method GET
acl CONNECT method CONNECT

http_access allow Firenet
http_reply_access allow all
http_access deny all

icp_access allow all
always_direct allow all

visible_hostname Dexter-Proxy

error_directory /usr/share/squid/errors/English
EOF

    squid -z 2>/dev/null || true

    systemctl enable squid 2>/dev/null || true
    systemctl restart squid 2>/dev/null || true

    # --------------------------------------------------------
    # Python WS proxy
    # --------------------------------------------------------

    wget -q \
        -O /etc/socks.py \
        https://mediatekvpn.uk/sabrinavpn/authentication/socks.py ||
        fail_install "socks.py download failed."

    dos2unix /etc/socks.py 2>/dev/null || true
    chmod 755 /etc/socks.py

    cat >/etc/systemd/system/socks.service <<'EOF'
[Unit]
Description=Python WS Proxy
After=network.target

[Service]
ExecStart=/usr/bin/python3 /etc/socks.py
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable socks
    systemctl restart socks

    # --------------------------------------------------------
    # Additional proxy scripts
    # --------------------------------------------------------

    wget -q \
        -O /etc/socks-ssh.py \
        https://mediatekvpn.uk/sabrinavpn/socks-ssh.py || true

    wget -q \
        -O /etc/socks-ws-ssh.py \
        https://mediatekvpn.uk/sabrinavpn/socks-ws-ssh.py || true

    wget -q \
        -O /etc/socks-ws-ssl.py \
        https://mediatekvpn.uk/sabrinavpn/socks-ws-ssl.py || true

    chmod 755 \
        /etc/socks-ssh.py \
        /etc/socks-ws-ssh.py \
        /etc/socks-ws-ssl.py \
        2>/dev/null || true
}

# ============================================================
# BBR
# ============================================================

install_bbr() {

    log "Enabling BBR..."

    sed -i \
        '/net.core.default_qdisc/d' \
        /etc/sysctl.conf

    sed -i \
        '/net.ipv4.tcp_congestion_control/d' \
        /etc/sysctl.conf

    echo "net.core.default_qdisc=fq" \
        >>/etc/sysctl.conf

    echo "net.ipv4.tcp_congestion_control=bbr" \
        >>/etc/sysctl.conf

    modprobe tcp_bbr 2>/dev/null || true

    sysctl -p >/dev/null 2>&1 || true

    log "TCP congestion control:"
    sysctl net.ipv4.tcp_congestion_control || true
}

# ============================================================
# FIREWALL / NAT
# ============================================================

install_firewall() {

    log "Configuring firewall and NAT..."

    cat >/etc/sysctl.d/99-vpn.conf <<EOF
net.ipv4.ip_forward=1
net.ipv4.conf.all.rp_filter=0
net.ipv4.conf.$server_interface.rp_filter=0
EOF

    sysctl --system >/dev/null 2>&1 || true

    # Flush existing IPv4 filter/NAT rules.
    iptables -F
    iptables -t nat -F

    # OpenVPN NAT
    iptables -t nat -A POSTROUTING \
        -s 10.20.0.0/16 \
        -o "$server_interface" \
        -j MASQUERADE

    iptables -t nat -A POSTROUTING \
        -s 10.30.0.0/24 \
        -o "$server_interface" \
        -j MASQUERADE

    # Hysteria UDP port range
    iptables -t nat -A PREROUTING \
        -i "$server_interface" \
        -p udp \
        --dport 10000:50000 \
        -j DNAT \
        --to-destination ":$HYSTERIA_PORT"

    # SlowDNS port
    iptables -I INPUT \
        -p udp \
        --dport 5300 \
        -j ACCEPT

    # Common VPN ports
    iptables -I INPUT \
        -p tcp \
        --dport "$PORT_TCP" \
        -j ACCEPT

    iptables -I INPUT \
        -p udp \
        --dport "$PORT_UDP" \
        -j ACCEPT

    iptables -I INPUT \
        -p tcp \
        --dport "$PORT_SSL" \
        -j ACCEPT

    iptables -I INPUT \
        -p tcp \
        --dport 22 \
        -j ACCEPT

    iptables -I INPUT \
        -p tcp \
        --dport 8080 \
        -j ACCEPT

    iptables -I INPUT \
        -p tcp \
        --dport 5666 \
        -j ACCEPT

    iptables -I INPUT \
        -p udp \
        --dport 5666 \
        -j ACCEPT

    # Save rules
    iptables-save >/etc/iptables_rules.v4

    ip6tables-save >/etc/iptables_rules.v6

    mkdir -p /etc/iptables

    cp /etc/iptables_rules.v4 \
        /etc/iptables/rules.v4

    cp /etc/iptables_rules.v6 \
        /etc/iptables/rules.v6

    # File limits
    sed -i \
        '/^\*\ *soft\ *nofile\ /d' \
        /etc/security/limits.conf

    sed -i \
        '/^\*\ *hard\ *nofile\ /d' \
        /etc/security/limits.conf

    echo '* soft nofile 65536' \
        >>/etc/security/limits.conf

    echo '* hard nofile 65536' \
        >>/etc/security/limits.conf
}

# ============================================================
# STUNNEL
# ============================================================

install_stunnel() {

    log "Configuring stunnel..."

    mkdir -p /etc/stunnel

    rm -f \
        /etc/stunnel/stunnel.key \
        /etc/stunnel/stunnel.crt \
        /etc/stunnel/stunnel.pem

    openssl req \
        -x509 \
        -newkey rsa:2048 \
        -nodes \
        -keyout /etc/stunnel/stunnel.key \
        -out /etc/stunnel/stunnel.crt \
        -days 3650 \
        -subj "/CN=$server_ip" ||
        fail_install "Stunnel certificate generation failed."

    cat \
        /etc/stunnel/stunnel.key \
        /etc/stunnel/stunnel.crt \
        >/etc/stunnel/stunnel.pem

    chmod 600 /etc/stunnel/stunnel.key
    chmod 600 /etc/stunnel/stunnel.pem
    chmod 644 /etc/stunnel/stunnel.crt

    cat >/etc/stunnel/stunnel.conf <<EOF
pid = /var/run/stunnel4.pid
debug = 3
output = /var/log/stunnel4.log

cert = /etc/stunnel/stunnel.pem

[openvpn-tcp]
connect = 127.0.0.1:$PORT_TCP
accept = 0.0.0.0:$PORT_SSL
EOF

    cat >/etc/default/stunnel4 <<'EOF'
ENABLED=1
FILES="/etc/stunnel/*.conf"
OPTIONS=""
PPP_RESTART=0
RLIMITS=""
EOF

    systemctl daemon-reload
    systemctl enable stunnel4

    systemctl restart stunnel4 ||
        fail_install "stunnel4 failed to start."
}

