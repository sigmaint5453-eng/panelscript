check_service() {

    SERVICE="$1"

    log "Checking service: $SERVICE"

    if systemctl is-active --quiet "$SERVICE"; then
        log "$SERVICE is ACTIVE."
        return 0
    fi

    log "$SERVICE is NOT ACTIVE."

    systemctl status "$SERVICE" \
        --no-pager \
        --full || true

    journalctl \
        -u "$SERVICE" \
        --no-pager \
        -n 80 || true

    return 1
}


verify_installation() {

    log "=========================================="
    log "VERIFYING INSTALLATION"
    log "=========================================="

    check_service openvpn@server.service \
        || return 1

    check_service openvpn@server2.service \
        || return 1

    check_service stunnel4.service \
        || return 1

    check_service socks.service \
        || return 1

    if systemctl list-unit-files \
        | grep -q '^hysteria-server.service'; then

        check_service hysteria-server.service \
            || return 1
    fi

    log "=========================================="
    log "ALL CRITICAL SERVICES ARE ACTIVE"
    log "=========================================="

    return 0
}


start_service () {

    clear

    echo 'Starting..'

    {

        crontab -l 2>/dev/null \
            | grep -v \
            -E '/etc/\.ws|/etc/\.hysteria|/etc/\.monitor|stunnel4 restart' \
            > /tmp/panel_cron 2>/dev/null || true


        cat >> /tmp/panel_cron <<'EOF'
* * * * * pgrep -x stunnel4 >/dev/null || /etc/init.d/stunnel4 restart >/dev/null 2>&1
* * * * * /bin/bash /etc/.ws >/dev/null 2>&1
* * * * * /bin/bash /etc/.hysteria >/dev/null 2>&1
* * * * * /bin/bash /etc/.monitor openvpn >/dev/null 2>&1
EOF

        crontab /tmp/panel_cron

        rm -f /tmp/panel_cron

        systemctl restart cron

    } 2>&1


    clear

    echo '++++++++++++++++++++++++++++++++++'
    echo '*       AIO  is ready!            *'
    echo '+++++++++++************+++++++++++'

    echo -e \
"[IP] : $server_ip
[Openvpn TCP Port] : $PORT_TCP
[Openvpn UDP Port] : $PORT_UDP
[Ssl Port] : $PORT_SSL
[Proxy Socks ] : 80
[Hysteria Port ] : 5666
[Proxy Squid 1] : 8080
[Proxy Squid 2] : 3128"


    # IMPORTANT:
    # Verify everything before reboot.
    if ! verify_installation; then

        echo
        echo "=========================================="
        echo "SERVER WILL NOT REBOOT."
        echo "INSTALLATION HAS A SERVICE FAILURE."
        echo
        echo "Check:"
        echo "$LOG_FILE"
        echo
        echo "OpenVPN UDP:"
        systemctl status \
            openvpn@server.service \
            --no-pager \
            --full || true

        echo
        echo "OpenVPN TCP:"
        systemctl status \
            openvpn@server2.service \
            --no-pager \
            --full || true

        echo "=========================================="

        exit 1
    fi


    history -c 2>/dev/null || true

    rm -f /usr/local/etc/.system

    echo
    echo "All critical services are ACTIVE."
    echo "Server will reboot after 20 seconds."

    sleep 20

    reboot
}


