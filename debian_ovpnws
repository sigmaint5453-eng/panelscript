install_require () {
    clear
    echo 'Installing dependencies (Legacy Python 2.7 Support)...'
    export DEBIAN_FRONTEND=noninteractive

    # 1. Update and Install tools
    apt update
    apt install -y curl wget cron python3-minimal libpython3-stdlib \
        iptables openvpn netcat-openbsd httpie php neofetch vnstat php-mysql \
        screen squid stunnel4 dropbear gnutls-bin \
        dos2unix nano unzip jq virt-what net-tools default-mysql-client \
        mlocate dh-make libaudit-dev build-essential fail2ban \
        libssl-dev zlib1g-dev libncurses5-dev libgdbm-dev libnss3-dev \
        libreadline-dev libffi-dev

    # 2. Compile Python 2.7.18
    cd /usr/src
    sudo wget https://mediatekvpn.uk/sabrinavpn/Python-2.7.18.tgz
    sudo tar xzf Python-2.7.18.tgz
    cd Python-2.7.18
    sudo ./configure --enable-optimizations
    sudo make altinstall

    # 3. Force symlink
    sudo ln -sf /usr/local/bin/python2.7 /usr/bin/python
    sudo ln -sf /usr/local/bin/python2.7 /usr/local/bin/python

    cd ~
    clear
    echo "Python version check:"
    python --version
}


install_squid(){
clear
echo 'Installing proxy.'
{
    wget --no-check-certificate -O /etc/init.d/squid $BASE_URL/squid.sh
    chmod +x /etc/init.d/squid
    update-rc.d squid defaults
    chown -cR proxy /var/log/squid
    squid -z
    cd /etc/squid/
    rm squid.conf
    echo "acl Firenet dst `curl -s https://api.ipify.org`" >> squid.conf
    echo 'http_port 8080
http_port 8181
visible_hostname Proxy
acl PURGE method PURGE
acl HEAD method HEAD
acl POST method POST
acl GET method GET
acl CONNECT method CONNECT
http_access allow Firenet
http_reply_access allow all
http_access deny all
icp_access allow all
always_direct allow all
visible_hostname Dexter-Proxy
error_directory /usr/share/squid/errors/English' >> squid.conf
    cd /usr/share/squid/errors/English
    rm ERR_INVALID_URL
    echo '<!--MtkDev--><!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><title>SECURE PROXY</title><meta name="viewport" content="width=device-width, initial-scale=1"><meta http-equiv="X-UA-Compatible" content="IE=edge"/><link rel="stylesheet" href="https://bootswatch.com/4/slate/bootstrap.min.css" media="screen"><link href="https://fonts.googleapis.com/css?family=Press+Start+2P" rel="stylesheet"><style>body{font-family: "Press Start 2P", cursive;}.fn-color{color: #ffff; background-image: -webkit-linear-gradient(92deg, #f35626, #feab3a); -webkit-background-clip: text; -webkit-text-fill-color: transparent; -webkit-animation: hue 5s infinite linear;}@-webkit-keyframes hue{from{-webkit-filter: hue-rotate(0deg);}to{-webkit-filter: hue-rotate(-360deg);}}</style></head><body><div class="container" style="padding-top: 50px"><div class="jumbotron"><h1 class="display-3 text-center fn-color">SECURE PROXY</h1><h4 class="text-center text-danger">SERVER</h4><p class="text-center">😍 %w 😍</p></div></div></body></html>' >> ERR_INVALID_URL
    chmod 755 *
    /etc/init.d/squid start
cd /etc || exit
# Download socks.py

wget -q "$BASE_URL/socks.py" -O /etc/socks.py
dos2unix /etc/socks.py
chmod +x /etc/socks.py

cat >/etc/systemd/system/socks.service <<'EOF'
[Unit]
Description=Python WS Proxy
After=network.target

[Service]
ExecStart=/usr/bin/python3 /etc/socks.py
Restart=always
User=root

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable socks
systemctl restart socks

wget "$BASE_URL/monitor" -O /etc/.monitor
wget "$BASE_URL/ws" -O /etc/.ws
wget "$BASE_URL/hysteria" -O /etc/.hysteria

sudo dos2unix /etc/.monitor
chmod +x /etc/.monitor
chmod +x /etc/.ws
chmod +x /etc/.hysteria
rm /etc/apt/sources.list
sudo cp /etc/apt/sources.list_backup /etc/apt/sources.list
} &>/dev/null
}



install_openvpn()
{
clear
echo "Installing openvpn."
{
mkdir -p /etc/openvpn/easy-rsa/keys
mkdir -p /etc/openvpn/login
mkdir -p /etc/openvpn/server
mkdir -p /var/www/html/stat
touch /etc/openvpn/server.conf
touch /etc/openvpn/server2.conf

echo 'DNS=1.1.1.1
DNSStubListener=no' >> /etc/systemd/resolved.conf

cat <<EOF > /etc/openvpn/server.conf
port PORT_UDP
proto udp
dev tun
server 10.20.0.0 255.255.0.0
max-clients 5000
ca /etc/openvpn/easy-rsa/keys/ca.crt
cert /etc/openvpn/easy-rsa/keys/server.crt
key /etc/openvpn/easy-rsa/keys/server.key
dh none
tls-server
tls-version-min 1.2
auth SHA256
cipher AES-128-GCM
data-ciphers AES-128-GCM:AES-256-GCM:AES-128-CBC
data-ciphers-fallback AES-128-CBC
keepalive 10 120
persist-key
persist-tun
user nobody
group nogroup
client-to-client
duplicate-cn
verify-client-cert none
username-as-common-name
script-security 3
auth-user-pass-verify "/etc/openvpn/login/auth_vpn" via-env
push "redirect-gateway def1 bypass-dhcp"
push "dhcp-option DNS 8.8.8.8"
push "dhcp-option DNS 8.8.4.4"
log /etc/openvpn/server/udpserver.log
status /etc/openvpn/server/udpclient.log
verb 3
client-connect /etc/openvpn/login/connect.sh
client-disconnect /etc/openvpn/login/disconnect.sh
EOF

cat <<EOF > /etc/openvpn/server2.conf
port PORT_TCP
proto tcp
dev tun
server 10.30.0.0 255.255.255.0
max-clients 5000
ca /etc/openvpn/easy-rsa/keys/ca.crt
cert /etc/openvpn/easy-rsa/keys/server.crt
key /etc/openvpn/easy-rsa/keys/server.key
dh none
tls-server
tls-version-min 1.2
cipher AES-128-CBC
auth SHA256
data-ciphers AES-128-CBC:AES-256-GCM:AES-128-GCM
data-ciphers-fallback AES-128-CBC
keepalive 10 120
persist-key
persist-tun
user nobody
group nogroup
client-to-client
duplicate-cn
username-as-common-name
script-security 3
auth-user-pass-verify "/etc/openvpn/login/auth_vpn" via-env
verify-client-cert none
push "redirect-gateway def1 bypass-dhcp"
push "dhcp-option DNS 8.8.8.8"
push "dhcp-option DNS 8.8.4.4"
log /etc/openvpn/server/tcpserver.log
status /etc/openvpn/server/tcpclient.log
verb 3
client-connect /etc/openvpn/login/connect.sh
client-disconnect /etc/openvpn/login/disconnect.sh
EOF

sed -i "s|PORT_UDP|$PORT_UDP|g" /etc/openvpn/server.conf
sed -i "s|PORT_TCP|$PORT_TCP|g" /etc/openvpn/server2.conf

cat <<\EOM >/etc/openvpn/login/config.sh
#!/bin/bash
HOST='DBHOST'
USER='DBUSER'
PASS='DBPASS'
DB='DBNAME'
EOM

sed -i "s|DBHOST|$HOST|g" /etc/openvpn/login/config.sh
sed -i "s|DBUSER|$USER|g" /etc/openvpn/login/config.sh
sed -i "s|DBPASS|$PASS|g" /etc/openvpn/login/config.sh
sed -i "s|DBNAME|$DBNAME|g" /etc/openvpn/login/config.sh

