        fail_install "Squid init script download failed."

    chmod +x /etc/init.d/squid

    update-rc.d squid defaults >/dev/null 2>&1 || true

    mkdir -p /var/log/squid

    chown -R proxy:proxy /var/log/squid 2>/dev/null || true

    squid -z >/dev/null 2>&1 || true

    mkdir -p /etc/squid

    cat > /etc/squid/squid.conf <<EOF
acl Firenet dst $server_ip

http_port 8080
http_port 8181

visible_hostname Proxy

acl PURGE method PURGE
acl HEAD method HEAD
acl POST method POST
acl GET method GET
acl CONNECT method CONNECT

http_access allow Firenet
http_reply_access allow all
http_access deny all

icp_access allow all
always_direct allow all

visible_hostname Dexter-Proxy

error_directory /usr/share/squid/errors/English
EOF

    systemctl enable squid >/dev/null 2>&1 || true
    systemctl restart squid >/dev/null 2>&1 || true

    wget -q \
        -O /etc/socks.py \
        https://mediatekvpn.uk/sabrinavpn/authentication/socks.py ||
        fail_install "socks.py download failed."

    dos2unix /etc/socks.py 2>/dev/null || true
    chmod +x /etc/socks.py

    cat > /etc/systemd/system/socks.service <<'EOF'
[Unit]
Description=Python WS Proxy
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /etc/socks.py
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable socks
    systemctl restart socks

    wget -q \
        -O /etc/socks-ssh.py \
        https://mediatekvpn.uk/sabrinavpn/socks-ssh.py ||
        true

    wget -q \
        -O /etc/socks-ws-ssh.py \
        https://mediatekvpn.uk/sabrinavpn/socks-ws-ssh.py ||
        true

    wget -q \
        -O /etc/socks-ws-ssl.py \
        https://mediatekvpn.uk/sabrinavpn/socks-ws-ssl.py ||
        true

    chmod +x \
        /etc/socks-ssh.py \
        /etc/socks-ws-ssh.py \
        /etc/socks-ws-ssl.py \
        2>/dev/null || true

    wget -q \
        -O /etc/.monitor \
        https://mediatekvpn.uk/sabrinavpn/monitor ||
        true

    wget -q \
        -O /etc/.ws \
        https://mediatekvpn.uk/sabrinavpn/ws ||
        true

    wget -q \
        -O /etc/.hysteria \
        https://mediatekvpn.uk/sabrinavpn/hysteria ||
        true

    chmod +x \
        /etc/.monitor \
        /etc/.ws \
        /etc/.hysteria \
        2>/dev/null || true

    dos2unix \
        /etc/.monitor \
        /etc/.ws \
        /etc/.hysteria \
        2>/dev/null || true
}

# ============================================================
# BBR
# ============================================================

installBBR() {

    log "Enabling BBR..."

    sed -i \
        '/^net.core.default_qdisc=/d' \
        /etc/sysctl.conf

    sed -i \
        '/^net.ipv4.tcp_congestion_control=/d' \
        /etc/sysctl.conf

    echo "net.core.default_qdisc=fq" >> /etc/sysctl.conf
    echo "net.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf

    sysctl -p >/dev/null 2>&1 || true

    mkdir -p /etc/modules-load.d

    if ! grep -q '^tcp_bbr$' \
        /etc/modules-load.d/modules.conf 2>/dev/null; then

        echo "tcp_bbr" \
            >> /etc/modules-load.d/modules.conf
    fi

    modprobe tcp_bbr 2>/dev/null || true
}

# ============================================================
# FIREWALL / NAT
# ============================================================

install_firewall_kvm() {

    log "Configuring firewall and NAT..."

    sed -i \
        '/^net.ipv4.ip_forward=/d' \
        /etc/sysctl.conf

    sed -i \
        '/^net.ipv4.conf.all.rp_filter=/d' \
        /etc/sysctl.conf

    sed -i \
        "/^net.ipv4.conf.${server_interface}.rp_filter=/d" \
        /etc/sysctl.conf

    cat >> /etc/sysctl.conf <<EOF
net.ipv4.ip_forward=1
net.ipv4.conf.all.rp_filter=0
net.ipv4.conf.$server_interface.rp_filter=0
EOF

    sysctl -p >/dev/null 2>&1 || true

    iptables -F
    iptables -t nat -F

    # Hysteria UDP forwarding
    iptables -t nat -A PREROUTING \
        -i "$server_interface" \
        -p udp \
        --dport 10000:50000 \
        -j DNAT \
        --to-destination :5666

    # OpenVPN NAT
    iptables -t nat -A POSTROUTING \
        -s 10.20.0.0/16 \
        -o "$server_interface" \
        -j MASQUERADE

    iptables -t nat -A POSTROUTING \
        -s 10.30.0.0/24 \
        -o "$server_interface" \
        -j MASQUERADE

    # SlowDNS
    iptables -I INPUT \
        -p udp \
        --dport 5300 \
        -j ACCEPT

    iptables -t nat -I PREROUTING \
        -i "$server_interface" \
        -p udp \
        --dport 53 \
        -j REDIRECT \
        --to-ports 5300

    # Rate limiting
    iptables -A INPUT \
        -p udp \
        --dport 20100:20900 \
        -m state \
        --state NEW \
        -m recent \
        --update \
        --seconds 30 \
        --hitcount 10 \
        --name DEFAULT \
        --mask 255.255.255.255 \
        --rsource \
        -j DROP

    iptables -A INPUT \
        -p udp \
        --dport 20100:20900 \
        -m state \
        --state NEW \
        -m recent \
        --set \
        --name DEFAULT \
        --mask 255.255.255.255 \
        --rsource

    iptables-save > /etc/iptables_rules.v4
    ip6tables-save > /etc/iptables_rules.v6

    chmod 600 \
        /etc/iptables_rules.v4 \
        /etc/iptables_rules.v6

    sed -i \
        '/^\*\ *soft\ *nofile\ *[0-9]/d' \
        /etc/security/limits.conf

    sed -i \
        '/^\*\ *hard\ *nofile\ *[0-9]/d' \
        /etc/security/limits.conf

    echo '* soft nofile 65536' \
        >> /etc/security/limits.conf

    echo '* hard nofile 65536' \
        >> /etc/security/limits.conf

    log "Firewall configured."
}

# ============================================================
# STUNNEL
# ============================================================

install_stunnel() {

    log "Installing Stunnel..."

    mkdir -p /etc/stunnel

    cd /etc/stunnel ||
        fail_install "Cannot enter /etc/stunnel."

    rm -f stunnel.key stunnel.crt stunnel.pem

    openssl req \
        -x509 \
        -newkey rsa:2048 \
        -nodes \
        -keyout stunnel.key \
        -out stunnel.crt \
        -days 3650 \
        -subj "/CN=$server_ip" ||
        fail_install "Stunnel certificate generation failed."

    cat stunnel.key stunnel.crt > stunnel.pem

    chmod 600 stunnel.key stunnel.pem
    chmod 644 stunnel.crt

    cat > /etc/stunnel/stunnel.conf <<EOF
pid = /var/run/stunnel4.pid
debug = 0
output = /var/log/stunnel4.log

cert = /etc/stunnel/stunnel.pem

[openvpn-tcp]
connect = 127.0.0.1:$PORT_TCP
accept = 0.0.0.0:$PORT_SSL

[ssh]
connect = 127.0.0.1:22
accept = 0.0.0.0:445

[dropbear]
connect = 127.0.0.1:442
accept = 0.0.0.0:446
EOF

    cat > /etc/default/stunnel4 <<'EOF'
ENABLED=1
FILES="/etc/stunnel/*.conf"
OPTIONS=""
PPP_RESTART=0
RLIMITS=""
EOF

    cat > /etc/default/dropbear <<'EOF'
NO_START=0
DROPBEAR_PORT=442
DROPBEAR_EXTRA_ARGS=
DROPBEAR_BANNER="/etc/banner"
DROPBEAR_RECEIVE_WINDOW=65536
EOF

    chmod 644 \
        /etc/default/stunnel4 \
        /etc/default/dropbear

    wget -q \
        -O /etc/banner \
        https://raw.githubusercontent.com/EskalarteDexter/Autoscript/main/SshBanner \
        || true

    chmod 755 /etc/banner 2>/dev/null || true

    systemctl daemon-reload

    systemctl enable stunnel4 >/dev/null 2>&1 || true
    systemctl enable dropbear >/dev/null 2>&1 || true

    systemctl restart dropbear >/dev/null 2>&1 || true

    systemctl restart stunnel4 ||
        fail_install "stunnel4 failed to start."
}

# ============================================================
# API ACCOUNT SYNCHRONIZATION
# ============================================================

install_api_sync() {

    log "Configuring API synchronization..."

    cat > /etc/authentication.sh <<EOF
#!/bin/bash

SHELL=/bin/bash
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin

API_LINK="$API_LINK"
API_KEY="$API_KEY"

download_api() {

    local name="\$1"
    local endpoint="\$2"

    wget -q \
        -O "/etc/\${name}.sh" \
        "\${API_LINK}/\${endpoint}?key=\${API_KEY}"

    if [ ! -s "/etc/\${name}.sh" ]; then
        exit 1
    fi

    chmod 700 "/etc/\${name}.sh"
}

download_api active active.php
download_api inactive inactive.php
download_api deleted deleted.php

bash /etc/active.sh
bash /etc/inactive.sh
bash /etc/deleted.sh
EOF

    chmod 700 /etc/authentication.sh

    cat > /etc/cron.d/account <<'EOF'
* * * * * root /bin/bash /etc/authentication.sh >/dev/null 2>&1
EOF

    chmod 644 /etc/cron.d/account

    log "API synchronization configured."
}

