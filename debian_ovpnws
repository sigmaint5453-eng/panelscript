iptables-restore \
    < /etc/iptables_rules.v4 \
    2>/dev/null || true

ip6tables-restore \
    < /etc/iptables_rules.v6 \
    2>/dev/null || true

sysctl -p \
    >/dev/null 2>&1 || true

systemctl restart stunnel4 \
    >/dev/null 2>&1 || true

systemctl restart openvpn@server.service \
    >/dev/null 2>&1 || true

systemctl restart openvpn@server2.service \
    >/dev/null 2>&1 || true

if ! pgrep -f "badvpn-udpgw.*7300" >/dev/null 2>&1; then

    screen -dmS udpvpn \
        /usr/bin/badvpn-udpgw \
        --listen-addr 127.0.0.1:7300 \
        --max-clients 10000 \
        --max-connections-for-client 10 \
        --client-socket-sndbuf 10000

fi

if [ -x /etc/.monitor ]; then
    bash /etc/.monitor openvpn \
        >/dev/null 2>&1 || true
fi

exit 0
EOF

    chmod +x /etc/rc.local

    cat > /etc/systemd/system/dexter.service <<'EOF'
[Unit]
Description=Dexter Server Service
After=network.target

[Service]
Type=oneshot
ExecStart=/bin/bash /etc/rc.local
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload

    systemctl enable openvpn@server.service ||
        fail_install "Unable to enable OpenVPN UDP."

    systemctl enable openvpn@server2.service ||
        fail_install "Unable to enable OpenVPN TCP."

    systemctl start openvpn@server.service ||
        fail_install "OpenVPN UDP failed to start."

    systemctl start openvpn@server2.service ||
        fail_install "OpenVPN TCP failed to start."

    if systemctl list-unit-files |
        grep -q '^hysteria-server.service'; then

        systemctl enable hysteria-server.service \
            >/dev/null 2>&1 || true

        systemctl restart hysteria-server.service \
            >/dev/null 2>&1 || true
    fi

    systemctl enable dexter.service ||
        fail_install "Unable to enable dexter service."

    systemctl start dexter.service ||
        fail_install "Dexter service failed."

    echo "Made with love by: MediatekVpn Developer..." \
        > /root/.web/index.php

    cat > /root/.ports <<EOF
tcp_port=$PORT_TCP
udp_port=$PORT_UDP
socket_port=80
squid_port=8080
hysteria_port=5666
ssh_port=22
dropbear_port=442
tcp_ssl_port=$PORT_SSL
udp_ssl_port=444
EOF

    chmod 600 /root/.ports
}

# ============================================================
# SERVICE CHECK
# ============================================================

check_service() {

    local service="$1"

    log "Checking $service..."

    if systemctl is-active --quiet "$service"; then
        log "$service : ACTIVE"
        return 0
    fi

    log "$service : NOT ACTIVE"

    systemctl status \
        "$service" \
        --no-pager \
        --full || true

    journalctl \
        -u "$service" \
        --no-pager \
        -n 50 || true

    return 1
}

# ============================================================
# VERIFY
# ============================================================

verify_installation() {

    log "=========================================="
    log "VERIFYING INSTALLATION"
    log "=========================================="

    check_service openvpn@server.service ||
        return 1

    check_service openvpn@server2.service ||
        return 1

    check_service stunnel4.service ||
        return 1

    check_service socks.service ||
        return 1

    if systemctl list-unit-files |
        grep -q '^hysteria-server.service'; then

        check_service hysteria-server.service ||
            return 1
    fi

    log "=========================================="
    log "ALL CRITICAL SERVICES ARE ACTIVE"
    log "=========================================="

    return 0
}

# ============================================================
# CRON
# ============================================================

configure_cron() {

    log "Configuring maintenance cron..."

    crontab -l 2>/dev/null |
        grep -v \
        -E '/etc/\.ws|/etc/\.hysteria|/etc/\.monitor|stunnel4 restart' \
        > /tmp/panel_cron 2>/dev/null || true

    cat >> /tmp/panel_cron <<'EOF'
* * * * * pgrep -x stunnel4 >/dev/null || /etc/init.d/stunnel4 restart >/dev/null 2>&1
* * * * * [ -x /etc/.ws ] && /bin/bash /etc/.ws >/dev/null 2>&1
* * * * * [ -x /etc/.hysteria ] && /bin/bash /etc/.hysteria >/dev/null 2>&1
* * * * * [ -x /etc/.monitor ] && /bin/bash /etc/.monitor openvpn >/dev/null 2>&1
EOF

    crontab /tmp/panel_cron
    rm -f /tmp/panel_cron

    systemctl restart cron
}

# ============================================================
# FINAL
# ============================================================

start_service() {

    configure_cron

    echo
    echo "=========================================="
    echo "        Debian OpenWS READY"
    echo "=========================================="
    echo
    echo "Server IP        : $server_ip"
    echo "OpenVPN TCP      : $PORT_TCP"
    echo "OpenVPN UDP      : $PORT_UDP"
    echo "SSL Port         : $PORT_SSL"
    echo "Squid            : 8080"
    echo "Hysteria         : 5666"
    echo "SSH              : 22"
    echo "Dropbear         : 442"
    echo "API              : $API_LINK"
    echo
    echo "=========================================="

    if ! verify_installation; then

        echo
        echo "=========================================="
        echo "INSTALLATION FAILED"
        echo "SERVER WILL NOT REBOOT."
        echo
        echo "Installation log:"
        echo "$LOG_FILE"
        echo "=========================================="

        exit 1
    fi

    history -c 2>/dev/null || true

    rm -f \
        /usr/local/etc/.system \
        2>/dev/null || true

    echo
    echo "All critical services are ACTIVE."
    echo
    echo "Server will reboot after 20 seconds."
    echo

    sleep 20

    reboot
}

