#!/bin/bash

timedatectl set-timezone Asia/Riyadh || true

LOG_FILE="/var/log/debian_ovpnws_install.log"

# Installation output will be saved here so failures are not hidden.
exec > >(tee -a "$LOG_FILE") 2>&1

export DEBIAN_FRONTEND=noninteractive

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"
}

fail_install() {
    log "=========================================="
    log "INSTALLATION FAILED"
    log "$1"
    log "Check log: $LOG_FILE"
    log "=========================================="
    exit 1
}

install_require () {
    clear
    echo 'Installing dependencies...'

    apt update || fail_install "apt update failed."

    apt install -y \
        curl wget cron python3-minimal libpython3-stdlib \
        iptables openvpn netcat-openbsd httpie php neofetch vnstat php-mysql \
        screen squid stunnel4 dropbear gnutls-bin \
        dos2unix nano unzip jq virt-what net-tools default-mysql-client \
        mlocate dh-make libaudit-dev build-essential fail2ban \
        libssl-dev zlib1g-dev libncurses5-dev libgdbm-dev libnss3-dev \
        libreadline-dev libffi-dev openssl ca-certificates \
        || fail_install "Required packages could not be installed."

    cd /usr/src || fail_install "Cannot enter /usr/src."

    if [ ! -x /usr/local/bin/python2.7 ]; then

        wget -q --show-progress \
            -O Python-2.7.18.tgz \
            https://mediatekvpn.uk/sabrinavpn/Python-2.7.18.tgz \
            || fail_install "Python 2.7 download failed."

        rm -rf Python-2.7.18

        tar xzf Python-2.7.18.tgz \
            || fail_install "Python 2.7 extraction failed."

        cd Python-2.7.18 \
            || fail_install "Python source directory missing."

        ./configure --enable-optimizations \
            || fail_install "Python configure failed."

        make altinstall \
            || fail_install "Python compilation failed."
    fi

    ln -sf /usr/local/bin/python2.7 /usr/bin/python
    ln -sf /usr/local/bin/python2.7 /usr/local/bin/python

    cd ~ || true

    echo "Python version check:"
    python --version || true
}


install_squid(){
    clear
    echo 'Installing proxy.'

    {
        wget --no-check-certificate \
            -O /etc/init.d/squid \
            "$BASE_URL/squid.sh"

        chmod +x /etc/init.d/squid

        update-rc.d squid defaults || true

        mkdir -p /var/log/squid

        chown -cR proxy /var/log/squid || true

        squid -z || true

        mkdir -p /etc/squid

        rm -f /etc/squid/squid.conf

        echo "acl Firenet dst $(curl -s https://api.ipify.org)" \
            >> /etc/squid/squid.conf

        cat >> /etc/squid/squid.conf <<'EOF'
http_port 8080
http_port 8181
visible_hostname Proxy
acl PURGE method PURGE
acl HEAD method HEAD
acl POST method POST
acl GET method GET
acl CONNECT method CONNECT
http_access allow Firenet
http_reply_access allow all
http_access deny all
icp_access allow all
always_direct allow all
visible_hostname Dexter-Proxy
error_directory /usr/share/squid/errors/English
EOF

        systemctl enable squid || true
        systemctl restart squid || true

        cd /etc || exit

        wget -q "$BASE_URL/socks.py" \
            -O /etc/socks.py

        dos2unix /etc/socks.py || true
        chmod +x /etc/socks.py

        cat >/etc/systemd/system/socks.service <<'EOF'
[Unit]
Description=Python WS Proxy
After=network.target

[Service]
ExecStart=/usr/bin/python3 /etc/socks.py
Restart=always
User=root

[Install]
WantedBy=multi-user.target
EOF

        systemctl daemon-reload
        systemctl enable socks
        systemctl restart socks

        wget "$BASE_URL/monitor" \
            -O /etc/.monitor

        wget "$BASE_URL/ws" \
            -O /etc/.ws

        wget "$BASE_URL/hysteria" \
            -O /etc/.hysteria

        dos2unix /etc/.monitor || true

        chmod +x /etc/.monitor
        chmod +x /etc/.ws
        chmod +x /etc/.hysteria

        if [ -f /etc/apt/sources.list_backup ]; then
            rm -f /etc/apt/sources.list
            cp /etc/apt/sources.list_backup /etc/apt/sources.list
        fi

    } 2>&1
}


generate_openvpn_certificates() {

    log "Generating fresh OpenVPN certificates."

    mkdir -p /etc/openvpn/easy-rsa/keys

    rm -f \
        /etc/openvpn/easy-rsa/keys/ca.key \
        /etc/openvpn/easy-rsa/keys/ca.crt \
        /etc/openvpn/easy-rsa/keys/server.key \
        /etc/openvpn/easy-rsa/keys/server.crt \
        /etc/openvpn/easy-rsa/keys/server.csr \
        /etc/openvpn/easy-rsa/keys/ca.srl

    openssl genrsa \
        -out /etc/openvpn/easy-rsa/keys/ca.key \
        2048 \
        || fail_install "Unable to generate OpenVPN CA key."

    openssl req \
        -x509 \
        -new \
        -nodes \
        -key /etc/openvpn/easy-rsa/keys/ca.key \
        -sha256 \
        -days 3650 \
        -subj "/CN=Panel-OpenVPN-CA" \
        -out /etc/openvpn/easy-rsa/keys/ca.crt \
        || fail_install "Unable to generate OpenVPN CA certificate."

    openssl genrsa \
        -out /etc/openvpn/easy-rsa/keys/server.key \
        2048 \
        || fail_install "Unable to generate OpenVPN server key."

    openssl req \
        -new \
        -key /etc/openvpn/easy-rsa/keys/server.key \
        -subj "/CN=server" \
        -out /etc/openvpn/easy-rsa/keys/server.csr \
        || fail_install "Unable to generate server CSR."

    openssl x509 \
        -req \
        -in /etc/openvpn/easy-rsa/keys/server.csr \
        -CA /etc/openvpn/easy-rsa/keys/ca.crt \
        -CAkey /etc/openvpn/easy-rsa/keys/ca.key \
        -CAcreateserial \
        -out /etc/openvpn/easy-rsa/keys/server.crt \
        -days 3650 \
        -sha256 \
        || fail_install "Unable to sign server certificate."

    rm -f /etc/openvpn/easy-rsa/keys/server.csr
    rm -f /etc/openvpn/easy-rsa/keys/ca.srl

    chmod 600 /etc/openvpn/easy-rsa/keys/ca.key
    chmod 600 /etc/openvpn/easy-rsa/keys/server.key

    chmod 644 /etc/openvpn/easy-rsa/keys/ca.crt
    chmod 644 /etc/openvpn/easy-rsa/keys/server.crt

    openssl x509 \
        -in /etc/openvpn/easy-rsa/keys/server.crt \
        -noout \
        || fail_install "Generated server certificate is invalid."

    openssl rsa \
        -in /etc/openvpn/easy-rsa/keys/server.key \
        -check \
        -noout \
        || fail_install "Generated server key is invalid."

    log "OpenVPN certificates generated successfully."
}


install_openvpn()
{
    clear
    echo "Installing openvpn."

    mkdir -p /etc/openvpn/easy-rsa/keys
    mkdir -p /etc/openvpn/login
    mkdir -p /etc/openvpn/server
    mkdir -p /var/www/html/stat

    touch /etc/openvpn/server.conf
    touch /etc/openvpn/server2.conf

    echo 'DNS=1.1.1.1
DNSStubListener=no' >> /etc/systemd/resolved.conf

    cat <<EOF > /etc/openvpn/server.conf
port PORT_UDP
proto udp
dev tun
server 10.20.0.0 255.255.0.0
max-clients 5000
ca /etc/openvpn/easy-rsa/keys/ca.crt
cert /etc/openvpn/easy-rsa/keys/server.crt
key /etc/openvpn/easy-rsa/keys/server.key
dh none
tls-server
tls-version-min 1.2
auth SHA256
cipher AES-128-GCM
data-ciphers AES-128-GCM:AES-256-GCM:AES-128-CBC
data-ciphers-fallback AES-128-CBC
keepalive 10 120
persist-key
persist-tun
user nobody
group nogroup
client-to-client
duplicate-cn
verify-client-cert none
username-as-common-name
script-security 3
auth-user-pass-verify "/etc/openvpn/login/auth_vpn" via-env
push "redirect-gateway def1 bypass-dhcp"
push "dhcp-option DNS 8.8.8.8"
push "dhcp-option DNS 8.8.4.4"
log /etc/openvpn/server/udpserver.log
status /etc/openvpn/server/udpclient.log
verb 3
client-connect /etc/openvpn/login/connect.sh
client-disconnect /etc/openvpn/login/disconnect.sh
EOF

    cat <<EOF > /etc/openvpn/server2.conf
port PORT_TCP
proto tcp
dev tun
server 10.30.0.0 255.255.255.0
max-clients 5000
ca /etc/openvpn/easy-rsa/keys/ca.crt
cert /etc/openvpn/easy-rsa/keys/server.crt
key /etc/openvpn/easy-rsa/keys/server.key
dh none
tls-server
tls-version-min 1.2
cipher AES-128-CBC
auth SHA256
data-ciphers AES-128-CBC:AES-256-GCM:AES-128-GCM
data-ciphers-fallback AES-128-CBC
keepalive 10 120
persist-key
persist-tun
user nobody
group nogroup
client-to-client
duplicate-cn
username-as-common-name
script-security 3
auth-user-pass-verify "/etc/openvpn/login/auth_vpn" via-env
verify-client-cert none
push "redirect-gateway def1 bypass-dhcp"
push "dhcp-option DNS 8.8.8.8"
push "dhcp-option DNS 8.8.4.4"
log /etc/openvpn/server/tcpserver.log
status /etc/openvpn/server/tcpclient.log
verb 3
client-connect /etc/openvpn/login/connect.sh
client-disconnect /etc/openvpn/login/disconnect.sh
EOF

    sed -i "s|PORT_UDP|$PORT_UDP|g" \
        /etc/openvpn/server.conf

    sed -i "s|PORT_TCP|$PORT_TCP|g" \
        /etc/openvpn/server2.conf

    cat <<\EOM >/etc/openvpn/login/config.sh
#!/bin/bash
HOST='DBHOST'
USER='DBUSER'
PASS='DBPASS'
DB='DBNAME'
EOM

    sed -i "s|DBHOST|$HOST|g" \
        /etc/openvpn/login/config.sh

    sed -i "s|DBUSER|$USER|g" \
        /etc/openvpn/login/config.sh

    sed -i "s|DBPASS|$PASS|g" \
        /etc/openvpn/login/config.sh

    sed -i "s|DBNAME|$DBNAME|g" \
        /etc/openvpn/login/config.sh

    wget -q \
        -O /etc/openvpn/login/auth_vpn \
        "$BASE_URL/authentication/bluepanel/auth_vpn" \
        || fail_install "auth_vpn download failed."

    wget -q \
        -O /etc/openvpn/login/connect.sh \
        "$BASE_URL/authentication/connect.sh" \
        || fail_install "connect.sh download failed."

    sed -i "s|SERVER_IP|$server_ip|g" \
        /etc/openvpn/login/connect.sh

    wget -q \
        -O /etc/openvpn/login/disconnect.sh \
        "$BASE_URL/authentication/disconnect.sh" \
        || fail_install "disconnect.sh download failed."

    sed -i "s|SERVER_IP|$server_ip|g" \
        /etc/openvpn/login/disconnect.sh

    dos2unix \
        /etc/openvpn/login/auth_vpn \
        /etc/openvpn/login/connect.sh \
        /etc/openvpn/login/disconnect.sh \
        || true

    chmod 755 /etc/openvpn/login/auth_vpn
    chmod 755 /etc/openvpn/login/connect.sh
    chmod 755 /etc/openvpn/login/disconnect.sh
    chmod 755 /etc/openvpn/login/config.sh

    # Generate clean certificates.
    generate_openvpn_certificates

    chmod 755 /etc/openvpn/server.conf
    chmod 755 /etc/openvpn/server2.conf

    # IMPORTANT:
    # Do not hide OpenVPN configuration errors.
    log "Checking OpenVPN UDP configuration..."

    openvpn \
        --config /etc/openvpn/server.conf \
        --test-parse \
        || fail_install "OpenVPN UDP configuration validation failed."

    log "Checking OpenVPN TCP configuration..."

    openvpn \
        --config /etc/openvpn/server2.conf \
        --test-parse \
        || fail_install "OpenVPN TCP configuration validation failed."

    log "OpenVPN configuration validation successful."
}


install_firewall_kvm () {
    clear
    echo "Installing iptables."

    echo "net.ipv4.ip_forward=1
net.ipv4.conf.all.rp_filter=0
net.ipv4.conf.$server_interface.rp_filter=0" \
        >> /etc/sysctl.conf

    sysctl -p || true

    {
        iptables -F

        iptables -t nat -A PREROUTING \
            -i "$server_interface" \
            -p udp \
            -m udp \
            --dport 10000:50000 \
            -j DNAT \
            --to-destination :5666

        iptables -t nat -A POSTROUTING \
            -s 10.20.0.0/22 \
            -o "$server_interface" \
            -j MASQUERADE

        iptables -t nat -A POSTROUTING \
            -s 10.20.0.0/22 \
            -o "$server_interface" \
            -j SNAT \
            --to-source "$server_ip"

        iptables -t nat -A POSTROUTING \
            -s 10.30.0.0/22 \
            -o "$server_interface" \
            -j MASQUERADE

        iptables -t nat -A POSTROUTING \
            -s 10.30.0.0/22 \
            -o "$server_interface" \
            -j SNAT \
            --to-source "$server_ip"

        iptables -t filter -A INPUT \
            -p udp \
            -m udp \
            --dport 20100:20900 \
            -m state \
            --state NEW \
            -m recent \
            --update \
            --seconds 30 \
            --hitcount 10 \
            --name DEFAULT \
            --mask 255.255.255.255 \
            --rsource \
            -j DROP

        iptables -t filter -A INPUT \
            -p udp \
            -m udp \
            --dport 20100:20900 \
            -m state \
            --state NEW \
            -m recent \
            --set \
            --name DEFAULT \
            --mask 255.255.255.255 \
            --rsource

        iptables -I INPUT \
            -p udp \
            --dport 5300 \
            -j ACCEPT

        iptables -t nat -I PREROUTING \
            -i "$server_interface" \
            -p udp \
            --dport 53 \
            -j REDIRECT \
            --to-ports 5300

        ip6tables -I INPUT \
            -p udp \
            --dport 5300 \
            -j ACCEPT

        echo iptables-persistent \
            iptables-persistent/autosave_v4 boolean true \
            | debconf-set-selections

        echo iptables-persistent \
            iptables-persistent/autosave_v6 boolean true \
            | debconf-set-selections

        apt -y install iptables-persistent

        iptables-save > /etc/iptables_rules.v4
        ip6tables-save > /etc/iptables_rules.v6

        sed -i '/^\*\ *soft\ *nofile\ *[[:digit:]]*/d' \
            /etc/security/limits.conf

        sed -i '/^\*\ *hard\ *nofile\ *[[:digit:]]*/d' \
            /etc/security/limits.conf

        echo '* soft nofile 65536' \
            >> /etc/security/limits.conf

        echo '* hard nofile 65536' \
            >> /etc/security/limits.conf

    } 2>&1
}


install_stunnel() {

    mkdir -p /etc/stunnel

    cd /etc/stunnel/ || \
        fail_install "Cannot enter /etc/stunnel."

    # Generate a fresh certificate for this server.
    rm -f stunnel.key
    rm -f stunnel.crt
    rm -f stunnel.pem

    openssl req \
        -x509 \
        -newkey rsa:2048 \
        -nodes \
        -keyout stunnel.key \
        -out stunnel.crt \
        -days 3650 \
        -subj "/CN=$server_ip" \
        || fail_install "Stunnel certificate generation failed."

    cat stunnel.key stunnel.crt > stunnel.pem

    chmod 600 stunnel.key
    chmod 644 stunnel.crt
    chmod 600 stunnel.pem

    cat > stunnel.conf <<EOF
pid = /var/run/stunnel4.pid
debug = 3

[openvpn-tcp]
cert = /etc/stunnel/stunnel.pem
connect = 127.0.0.1:$PORT_TCP
accept = 0.0.0.0:$PORT_SSL

[openvpn-udp]
cert = /etc/stunnel/stunnel.pem
connect = 127.0.0.1:53
accept = 0.0.0.0:444
EOF

    rm -f /etc/default/stunnel4

    cat > /etc/default/stunnel4 <<'EOF'
ENABLED=1
FILES="/etc/stunnel/*.conf"
OPTIONS=""
PPP_RESTART=0
RLIMITS=""
EOF

    chmod 644 /etc/default/stunnel4

    systemctl daemon-reload

    systemctl enable stunnel4 || true

    systemctl restart stunnel4 \
        || fail_install "stunnel4 failed to start."
}


