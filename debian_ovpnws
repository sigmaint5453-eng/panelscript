#!/bin/bash

# ============================================================
# Debian OpenVPN + WS + Hysteria + Squid + Stunnel Installer
# ============================================================

set -o pipefail

export DEBIAN_FRONTEND=noninteractive

LOG_FILE="/var/log/debian_ovpnws_install.log"
exec > >(tee -a "$LOG_FILE") 2>&1

timedatectl set-timezone Asia/Riyadh 2>/dev/null || true

# ============================================================
# LOGGING
# ============================================================

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"
}

fail_install() {
    log "=========================================="
    log "INSTALLATION FAILED"
    log "$1"
    log "Check log: $LOG_FILE"
    log "=========================================="
    exit 1
}

# ============================================================
# PRIVATE CONFIGURATION
# These values are requested at install time.
# Do NOT put real passwords/API keys in GitHub.
# ============================================================

echo
echo "=========================================="
echo "       SERVER CONFIGURATION"
echo "=========================================="
echo

read -rp "Database Host [127.0.0.1]: " HOST
HOST="${HOST:-127.0.0.1}"

while [ -z "$USER" ]; do
    read -rp "Database User: " USER
done

read -rsp "Database Password: " PASS
echo

while [ -z "$DBNAME" ]; do
    read -rp "Database Name: " DBNAME
done

echo
read -rp "API Link [https://premiumint.xyz/api/authentication]: " API_LINK
API_LINK="${API_LINK:-https://premiumint.xyz/api/authentication}"

read -rsp "API Key: " API_KEY
echo

read -rsp "adminmtk SSH Password: " ADMIN_PASSWORD
echo

if [ -z "$PASS" ]; then
    fail_install "Database password cannot be empty."
fi

if [ -z "$API_KEY" ]; then
    fail_install "API key cannot be empty."
fi

if [ -z "$ADMIN_PASSWORD" ]; then
    fail_install "adminmtk password cannot be empty."
fi

# ============================================================
# SERVER SETTINGS
# ============================================================

PORT_TCP=443
PORT_UDP=1194
PORT_SSL=8443
OBFS="mediatekvpn"

# ============================================================
# SERVER INFORMATION
# ============================================================

server_ip=""

server_interface=""

# ============================================================
# DETECT SERVER
# ============================================================

detect_server() {

    log "Detecting server information..."

    server_ip=$(
        curl -4 -s --max-time 10 https://api.ipify.org
    )

    if [ -z "$server_ip" ]; then
        fail_install "Could not determine public IP."
    fi

    server_interface=$(
        ip route get 8.8.8.8 2>/dev/null |
        awk '
        /dev/ {
            for(i=1;i<=NF;i++) {
                if($i=="dev") {
                    print $(i+1)
                    exit
                }
            }
        }'
    )

    if [ -z "$server_interface" ]; then
        server_interface="eth0"
    fi

    log "Server IP : $server_ip"
    log "Interface : $server_interface"
}

# ============================================================
# SUDO / SSH USER
# ============================================================

install_sudo() {

    log "Configuring admin user..."

    if ! id adminmtk >/dev/null 2>&1; then
        useradd -m adminmtk ||
            fail_install "Unable to create adminmtk."
    fi

    echo "adminmtk:$ADMIN_PASSWORD" |
        chpasswd ||
        fail_install "Unable to set adminmtk password."

    usermod -aG sudo adminmtk ||
        fail_install "Unable to add adminmtk to sudo group."

    if grep -q '^PermitRootLogin yes' /etc/ssh/sshd_config; then
        sed -i \
            's/^PermitRootLogin yes/PermitRootLogin no/' \
            /etc/ssh/sshd_config
    fi

    if ! grep -q '^AllowGroups adminmtk' /etc/ssh/sshd_config; then
        echo "AllowGroups adminmtk" >> /etc/ssh/sshd_config
    fi

    if systemctl restart ssh 2>/dev/null; then
        :
    elif systemctl restart sshd 2>/dev/null; then
        :
    else
        fail_install "SSH restart failed."
    fi
}

