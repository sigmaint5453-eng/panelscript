# ============================================================
# PYTHON 2.7
# ============================================================

install_python27() {

    log "Installing Python 2.7..."

    if [ -x /usr/local/bin/python2.7 ]; then
        log "Python 2.7 already installed."
        return 0
    fi

    cd /usr/src ||
        fail_install "Cannot enter /usr/src."

    rm -f Python-2.7.18.tgz
    rm -rf Python-2.7.18

    wget \
        --no-check-certificate \
        -q \
        -O Python-2.7.18.tgz \
        https://mediatekvpn.uk/sabrinavpn/Python-2.7.18.tgz ||
        fail_install "Python 2.7 download failed."

    tar xzf Python-2.7.18.tgz ||
        fail_install "Python 2.7 extraction failed."

    cd Python-2.7.18 ||
        fail_install "Python source directory missing."

    ./configure --enable-optimizations ||
        fail_install "Python configure failed."

    make altinstall ||
        fail_install "Python compilation failed."

    ln -sf /usr/local/bin/python2.7 /usr/local/bin/python

    log "Python 2.7 installed."
}

# ============================================================
# DATABASE CONNECTION TEST
# ============================================================

test_database() {

    log "Testing database connection..."

    mysql \
        -h "$HOST" \
        -u "$USER" \
        -p"$PASS" \
        -D "$DBNAME" \
        -e "SELECT 1;" >/dev/null 2>&1 ||

        fail_install \
        "Database connection failed. Check host/user/password/database."

    log "Database connection OK."
}

# ============================================================
# OPENVPN CERTIFICATES
# ============================================================

generate_openvpn_certificates() {

    log "Generating OpenVPN certificates..."

    mkdir -p /etc/openvpn/easy-rsa/keys

    rm -f \
        /etc/openvpn/easy-rsa/keys/ca.key \
        /etc/openvpn/easy-rsa/keys/ca.crt \
        /etc/openvpn/easy-rsa/keys/server.key \
        /etc/openvpn/easy-rsa/keys/server.crt \
        /etc/openvpn/easy-rsa/keys/server.csr \
        /etc/openvpn/easy-rsa/keys/ca.srl

    openssl genrsa \
        -out /etc/openvpn/easy-rsa/keys/ca.key \
        2048 ||
        fail_install "Unable to generate CA key."

    openssl req \
        -x509 \
        -new \
        -nodes \
        -key /etc/openvpn/easy-rsa/keys/ca.key \
        -sha256 \
        -days 3650 \
        -subj "/CN=Panel-OpenVPN-CA" \
        -out /etc/openvpn/easy-rsa/keys/ca.crt ||
        fail_install "Unable to generate CA certificate."

    openssl genrsa \
        -out /etc/openvpn/easy-rsa/keys/server.key \
        2048 ||
        fail_install "Unable to generate server key."

    openssl req \
        -new \
        -key /etc/openvpn/easy-rsa/keys/server.key \
        -subj "/CN=server" \
        -out /etc/openvpn/easy-rsa/keys/server.csr ||
        fail_install "Unable to generate server CSR."

    openssl x509 \
        -req \
        -in /etc/openvpn/easy-rsa/keys/server.csr \
        -CA /etc/openvpn/easy-rsa/keys/ca.crt \
        -CAkey /etc/openvpn/easy-rsa/keys/ca.key \
        -CAcreateserial \
        -out /etc/openvpn/easy-rsa/keys/server.crt \
        -days 3650 \
        -sha256 ||
        fail_install "Unable to sign server certificate."

    rm -f \
        /etc/openvpn/easy-rsa/keys/server.csr \
        /etc/openvpn/easy-rsa/keys/ca.srl

    chmod 600 \
        /etc/openvpn/easy-rsa/keys/ca.key \
        /etc/openvpn/easy-rsa/keys/server.key

    chmod 644 \
        /etc/openvpn/easy-rsa/keys/ca.crt \
        /etc/openvpn/easy-rsa/keys/server.crt

    openssl x509 \
        -in /etc/openvpn/easy-rsa/keys/server.crt \
        -noout ||
        fail_install "Server certificate validation failed."

    openssl rsa \
        -in /etc/openvpn/easy-rsa/keys/server.key \
        -check \
        -noout ||
        fail_install "Server private key validation failed."

    log "OpenVPN certificates generated successfully."
}

# ============================================================
# OPENVPN
# ============================================================

install_openvpn() {

    log "Installing OpenVPN..."

    mkdir -p /etc/openvpn/login
    mkdir -p /etc/openvpn/server
    mkdir -p /var/www/html/stat

    cat > /etc/openvpn/server.conf <<EOF
port $PORT_UDP
proto udp
dev tun

server 10.20.0.0 255.255.0.0
max-clients 5000

ca /etc/openvpn/easy-rsa/keys/ca.crt
cert /etc/openvpn/easy-rsa/keys/server.crt
key /etc/openvpn/easy-rsa/keys/server.key

dh none
tls-server
tls-version-min 1.2

auth SHA256
cipher AES-128-GCM
data-ciphers AES-128-GCM:AES-256-GCM:AES-128-CBC
data-ciphers-fallback AES-128-CBC

keepalive 10 120

persist-key
persist-tun

user nobody
group nogroup

client-to-client
duplicate-cn

verify-client-cert none
username-as-common-name

script-security 3
auth-user-pass-verify "/etc/openvpn/login/auth_vpn" via-env

push "redirect-gateway def1 bypass-dhcp"
push "dhcp-option DNS 8.8.8.8"
push "dhcp-option DNS 8.8.4.4"

log /etc/openvpn/server/udpserver.log
status /etc/openvpn/server/udpclient.log

verb 3

client-connect /etc/openvpn/login/connect.sh
client-disconnect /etc/openvpn/login/disconnect.sh
EOF

    cat > /etc/openvpn/server2.conf <<EOF
port $PORT_TCP
proto tcp
dev tun

server 10.30.0.0 255.255.255.0
max-clients 5000

ca /etc/openvpn/easy-rsa/keys/ca.crt
cert /etc/openvpn/easy-rsa/keys/server.crt
key /etc/openvpn/easy-rsa/keys/server.key

dh none
tls-server
tls-version-min 1.2

cipher AES-128-CBC
auth SHA256

data-ciphers AES-128-CBC:AES-256-GCM:AES-128-GCM
data-ciphers-fallback AES-128-CBC

keepalive 10 120

persist-key
persist-tun

user nobody
group nogroup

client-to-client
duplicate-cn
username-as-common-name

script-security 3
auth-user-pass-verify "/etc/openvpn/login/auth_vpn" via-env

verify-client-cert none

push "redirect-gateway def1 bypass-dhcp"
push "dhcp-option DNS 8.8.8.8"
push "dhcp-option DNS 8.8.4.4"

log /etc/openvpn/server/tcpserver.log
status /etc/openvpn/server/tcpclient.log

verb 3

client-connect /etc/openvpn/login/connect.sh
client-disconnect /etc/openvpn/login/disconnect.sh
EOF

    cat > /etc/openvpn/login/config.sh <<EOF
#!/bin/bash

HOST='$HOST'
USER='$USER'
PASS='$PASS'
DB='$DBNAME'
EOF

    chmod 700 /etc/openvpn/login/config.sh

    # --------------------------------------------------------
    # Authentication
    # --------------------------------------------------------

    wget -q \
        -O /etc/openvpn/login/auth_vpn \
        https://mediatekvpn.uk/sabrinavpn/authentication/bluepanel/auth_vpn ||
        fail_install "auth_vpn download failed."

    wget -q \
        -O /etc/openvpn/login/connect.sh \
        https://mediatekvpn.uk/sabrinavpn/authentication/connect.sh ||
        fail_install "connect.sh download failed."

    sed -i \
        "s|SERVER_IP|$server_ip|g" \
        /etc/openvpn/login/connect.sh

    wget -q \
        -O /etc/openvpn/login/disconnect.sh \
        https://mediatekvpn.uk/sabrinavpn/authentication/disconnect.sh ||
        fail_install "disconnect.sh download failed."

    sed -i \
        "s|SERVER_IP|$server_ip|g" \
        /etc/openvpn/login/disconnect.sh

    dos2unix \
        /etc/openvpn/login/auth_vpn \
        /etc/openvpn/login/connect.sh \
        /etc/openvpn/login/disconnect.sh \
        2>/dev/null || true

    chmod 755 \
        /etc/openvpn/login/auth_vpn \
        /etc/openvpn/login/connect.sh \
        /etc/openvpn/login/disconnect.sh

    generate_openvpn_certificates

    log "Validating OpenVPN UDP configuration..."

    openvpn \
        --config /etc/openvpn/server.conf \
        --test-parse ||
        fail_install "OpenVPN UDP configuration invalid."

    log "Validating OpenVPN TCP configuration..."

    openvpn \
        --config /etc/openvpn/server2.conf \
        --test-parse ||
        fail_install "OpenVPN TCP configuration invalid."

    log "OpenVPN configuration valid."
}

# ============================================================
# HYSTERIA
# ============================================================

install_hysteria() {

    log "Installing Hysteria..."

    wget \
        --no-check-certificate \
        -q \
        -O /root/install_server.sh \
        https://mediatekvpn.uk/sabrinavpn/install_server.sh ||
        fail_install "Hysteria installer download failed."

    chmod +x /root/install_server.sh

    cd /root ||
        fail_install "Cannot enter /root."

    ./install_server.sh --version v1.3.5 ||
        fail_install "Hysteria installation failed."

    mkdir -p /etc/hysteria

    cat > /etc/hysteria/config.json <<EOF
{
  "listen": ":5666",
  "cert": "/etc/openvpn/easy-rsa/keys/server.crt",
  "key": "/etc/openvpn/easy-rsa/keys/server.key",
  "up_mbps": 100,
  "down_mbps": 100,
  "disable_udp": false,
  "obfs": "$OBFS",
  "auth": {
    "mode": "external",
    "config": {
      "cmd": "./.auth.sh"
    }
  },
  "prometheus_listen": ":5665",
  "recv_window_conn": 107374182400,
  "recv_window_client": 13421772800
}
EOF

    cat > /etc/hysteria/.auth.sh <<'EOF'
#!/bin/bash

. /etc/openvpn/login/config.sh

if [ "$#" -ne 4 ]; then
    echo "invalid number of arguments"
    exit 1
fi

ADDR="$1"
AUTH="$2"
SEND="$3"
RECV="$4"

USERNAME="${AUTH%%:*}"
PASSWORD="${AUTH#*:}"

if [ -z "$USERNAME" ] || [ -z "$PASSWORD" ]; then
    echo "authentication failed."
    exit 1
fi

SAFE_USERNAME="$(printf '%s' "$USERNAME" |
    sed "s/'/''/g")"

SAFE_PASSWORD="$(printf '%s' "$PASSWORD" |
    sed "s/'/''/g")"

QUERY="
SELECT user_name
FROM users
WHERE user_name='$SAFE_USERNAME'
AND auth_vpn=md5('$SAFE_PASSWORD')
AND status='live'
AND is_freeze=0
AND is_ban=0
AND (
    duration > 0
    OR vip_duration > 0
    OR private_duration > 0
)
LIMIT 1
"

USER_NAME="$(
    mysql \
        -u "$USER" \
        -p"$PASS" \
        -D "$DB" \
        -h "$HOST" \
        -sN \
        -e "$QUERY" 2>/dev/null
)"

if [ "$USER_NAME" = "$USERNAME" ]; then
    echo "authentication ok."
    exit 0
fi

echo "authentication failed."
exit 1
EOF

    chmod 755 /etc/hysteria/.auth.sh
    chmod 644 /etc/hysteria/config.json

    sysctl -w net.core.rmem_max=16777216 >/dev/null 2>&1 || true
    sysctl -w net.core.wmem_max=16777216 >/dev/null 2>&1 || true

    wget -q \
        -O /usr/bin/badvpn-udpgw \
        https://mediatekvpn.uk/sabrinavpn/badvpn-udpgw64 ||
        fail_install "badvpn-udpgw download failed."

    chmod +x /usr/bin/badvpn-udpgw
}

