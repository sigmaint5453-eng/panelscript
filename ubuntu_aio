install_hysteria(){
clear
echo 'Installing hysteria.'
{

# Download & install Hysteria v1.3.5
wget -N --no-check-certificate -q -O ~/install_server.sh https://mediatekvpn.uk/sabrinavpn/install_server.sh; chmod +x ~/install_server.sh; ./install_server.sh --version v1.3.5

